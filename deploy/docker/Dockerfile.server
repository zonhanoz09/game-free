# Multi-stage production build for Rust Game Server
FROM rust:1.88-alpine AS builder
RUN apk add --no-cache musl-dev
WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY assets ./assets
COPY apps/client/Cargo.toml ./apps/client/Cargo.toml
RUN mkdir -p apps/client/src && printf 'fn main() {}\n' > apps/client/src/main.rs
COPY apps/server/Cargo.toml apps/server/Cargo.lock ./apps/server/
COPY apps/server/src ./apps/server/src
RUN cargo build --release -p tactical-arena-server

FROM alpine:3.21
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /build/target/release/tactical-arena-server /usr/local/bin/tactical-arena-server

EXPOSE 8080
ENV PORT=8080
ENV RUST_LOG=info

CMD ["tactical-arena-server"]
